              "mode": "raw",
              "raw": "{\n  \"bySelf\": [\n    {\n      \"description\": \"Residential house at Chennai\",\n      \"location\": \"Chennai\",\n      \"registrationNo\": \"REG/2020/001\",\n      \"dateOfAcquisition\": \"2020-01-15\",\n      \"costOfAcquisition\": 5000000,\n      \"marketValue\": 7500000,\n      \"encumbrances\": \"Home loan from SBI\"\n    }\n  ],\n  \"bySharing\": [\n    {\n      \"description\": \"Commercial plot\",\n      \"location\": \"Coimbatore\",\n      \"sharePercentage\": 50,\n      \"costOfAcquisition\": 2000000,\n      \"marketValue\": 3000000,\n      \"encumbrances\": \"\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/v1/certificates/{{certificateId}}/annexure1", "host": ["{{baseUrl}}"], "path": ["api", "v1", "certificates", "{{certificateId}}", "annexure1"] }
          }
        },
        {
          "name": "Add Row to Annexure 1 (bySelf)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"description\": \"New flat in Mumbai\",\n  \"location\": \"Mumbai\",\n  \"registrationNo\": \"REG/2024/999\",\n  \"dateOfAcquisition\": \"2024-06-01\",\n  \"costOfAcquisition\": 8000000,\n  \"marketValue\": 9500000,\n  \"encumbrances\": \"None\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/certificates/{{certificateId}}/annexure1/bySelf",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "certificates", "{{certificateId}}", "annexure1", "bySelf"],
              "variable": [{ "key": "section", "value": "bySelf", "description": "bySelf | bySharing" }]
            }
          }
        },
        {
          "name": "Update Row in Annexure 1",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"marketValue\": 10000000,\n  \"encumbrances\": \"Cleared\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/certificates/{{certificateId}}/annexure1/bySelf/:rowId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "certificates", "{{certificateId}}", "annexure1", "bySelf", ":rowId"],
              "variable": [{ "key": "rowId", "value": "REPLACE_WITH_ROW_ID" }]
            }
          }
        },
        {
          "name": "Delete Row from Annexure 1",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/certificates/{{certificateId}}/annexure1/bySelf/:rowId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "certificates", "{{certificateId}}", "annexure1", "bySelf", ":rowId"],
              "variable": [{ "key": "rowId", "value": "REPLACE_WITH_ROW_ID" }]
            }
          }
        }
      ]
    },
